<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <Platforms>x86</Platforms>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SDRSharp.PlutoSDR</AssemblyName>
    <RootNamespace>SDRSharp.PlutoSDR</RootNamespace>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.0.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>PlutoSDR frontend for SDR#</Product>
    <Company>SDR# PlutoSDR plugin</Company>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <NoWarn>$(NoWarn);CS0649;CS0169</NoWarn>
  </PropertyGroup>

  <!-- Reference the SDR# host assemblies for compilation only.
       They must NOT be copied next to the plugin: SDR# provides them at runtime and a
       second copy would collide with the already-loaded assembly. -->
  <ItemGroup>
    <Reference Include="SDRSharp.Radio">
      <HintPath>refs\SDRSharp.Radio.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SDRSharp.Common">
      <HintPath>refs\SDRSharp.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SDRSharp.PanView">
      <HintPath>refs\SDRSharp.PanView.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
